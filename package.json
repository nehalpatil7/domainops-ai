{
  "name": "domainops-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered public domain troubleshooting on Cloudflare",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "dev": "vite dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src test vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types env.d.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.34",
    "@ai-sdk/react": "^4.0.157",
    "@cloudflare/ai-chat": "^0.12.2",
    "agents": "^0.30.1",
    "ai": "^7.0.153",
    "jose": "^6.2.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22"
  }
}
