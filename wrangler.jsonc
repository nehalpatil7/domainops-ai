{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domainops-ai",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "keep_names": true,
  "upload_source_maps": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WorkspaceDomainStore",
        "class_name": "WorkspaceDomainStore",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceDomainStore"],
    },
  ],
  "workflows": [
    {
      "name": "domain-revalidation-workflow",
      "binding": "DOMAIN_REVALIDATION_WORKFLOW",
      "class_name": "DomainRevalidationWorkflow",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
