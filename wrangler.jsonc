{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domainops-ai",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "keep_names": true,
  "upload_source_maps": true,
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WorkspaceDomainStore",
        "class_name": "WorkspaceDomainStore",
      },
      {
        "name": "DomainOpsChatAgent",
        "class_name": "DomainOpsChatAgent",
      },
      {
        "name": "WorkspaceCatalog",
        "class_name": "WorkspaceCatalog",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceDomainStore"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DomainOpsChatAgent"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["WorkspaceCatalog"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
