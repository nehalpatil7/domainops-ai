{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domainops-ai-test",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "keep_names": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "WorkspaceDomainStore",
        "class_name": "WorkspaceDomainStore",
      },
      {
        "name": "DomainOpsChatAgent",
        "class_name": "DomainOpsChatAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceDomainStore"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DomainOpsChatAgent"],
    },
  ],
  "workflows": [
    {
      "name": "domain-revalidation-workflow-test",
      "binding": "DOMAIN_REVALIDATION_WORKFLOW",
      "class_name": "DomainRevalidationWorkflow",
    },
  ],
}
